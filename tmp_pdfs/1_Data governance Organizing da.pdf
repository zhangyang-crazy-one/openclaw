      <script type="eba4fc23c75a452621774362-text/javascript">
        
        window.appData = window.appData || [];
        window.pageTargeting = {"region":"us-east-1","platform":"sdtech","entitled":false,"crawler":"","journal":"Government Information Quarterly","auth":"AE"};
        window.arp = {
          config: {"adobeSuite":"elsevier-sd-prod","aiNavigation":{"enabled":true,"version":"V1"},"arsUrl":"https://ars.els-cdn.com","assetRoute":"/us-east-1/prod/ce2dc43a8712db705091d063c1788f1b18edfbc9","recommendationsFeedback":{"enabled":true,"url":"https://feedback.recs.d.elsevier.com/raw/events","timeout":60000},"googleMapsApiKey":"AIzaSyCBYU6I6lrbEU6wQXUEIte3NwGtm3jwHQc","mediaBaseUrl":"https://ars.els-cdn.com/content/image/","xocsMediaPlayerBaseUrl":"/shared-assets/147/js/ableplayer","strictMode":false,"scienceDirectUrl":"https://www.sciencedirect.com","seamlessAccess":{"enableSeamlessAccess":true,"scriptUrl":"https://unpkg.com/@theidentityselector/thiss-ds@1.0.13/dist/thiss-ds.js","persistenceUrl":"https://service.seamlessaccess.org/ps/","persistenceContext":"seamlessaccess.org","shibAuthUrl":"https://auth.elsevier.com/ShibAuth/institutionLogin"},"reaxys":{"apiUrl":"https://reaxys-sdlc.reaxys.com","origin":"sciencedirect","queryBuilderHostPath":"https://www.reaxys.com/reaxys/secured/hopinto.do","url":"https://www.reaxys.com"},"oneTrustCookie":{"enabled":true},"shadowBackend":{"abstract":false,"citedBy":false,"glossary":false},"ssrn":{"url":"https://papers.ssrn.com","path":"/sol3/papers.cfm"},"newUi":true,"enableOptOut":false},
          subscriptions: [],
          subscribe: function(cb) {
            var self = this;
            var i = this.subscriptions.push(cb) - 1;
